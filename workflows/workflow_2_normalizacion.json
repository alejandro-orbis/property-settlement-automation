    },
    {
      "parameters": {
        "jsCode": "const movimientos = $('Leer Gastos Sin Clasificar').all().map(i => i.json);\n\nconst reglas = [\n  { patron: /limpieza|limpiezas/i, categoria: 'Gasto_Limpieza' },\n  { patron: /materiales/i, categoria: 'Gasto_Materiales' },\n  { patron: /el[ée]ctric/i, categoria: 'Gasto_Electricidad' },\n  { patron: /extintor/i, categoria: 'Gasto_MantenimientoSeguridad' },\n  { patron: /telefonillo|aluminio|fontaner|pintura|albañ/i, categoria: 'Gasto_Reparacion' },\n];\n\nconst result = movimientos.map(mov => {\n  const regla = reglas.find(r => r.patron.test(mov.descripcion));\n  const categoria = regla ? regla.categoria : 'Gasto_SinClasificar_Revisar';\n\n  return {\n    json: {\n      id: mov.id,\n      descripcion: mov.descripcion,\n      categoria: categoria,\n      requiere_revision: !regla\n    }\n  };\n});\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
