    {
      "parameters": {
        "jsCode": "const gastos = $('Leer Gastos Sin Propiedad').all().map(i => i.json);\nconst propiedades = $('Leer Todas las Direcciones').all().map(i => i.json);\n\nif (gastos.length === 0) {\n  return [{ json: { sin_gastos_que_resolver: true } }];\n}\n\nfunction normalizar(texto) {\n  return (texto || '')\n    .toLowerCase()\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^a-z0-9\\s]/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nconst PALABRAS_IGNORAR = ['calle', 'avenida', 'plaza', 'piso', 'planta', 'derecha', 'izquierda', 'bajo', 'direccion', 'exacta', 'pendiente', 'confirmar', 'bilbao', 'madrid'];\n\nconst result = gastos.map(g => {\n  const descNorm = normalizar(g.descripcion);\n  let mejorMatch = null;\n  let mejorScore = 0;\n\n  for (const p of propiedades) {\n    const dirNorm = normalizar(p.direccion);\n    const tokens = dirNorm.split(' ').filter(t => t.length >= 4 && !PALABRAS_IGNORAR.includes(t));\n    const score = tokens.filter(t => descNorm.includes(t)).length;\n\n    if (score > mejorScore) {\n      mejorScore = score;\n      mejorMatch = p;\n    }\n  }\n\n  return {\n    json: {\n      movimiento_id: g.id,\n      propiedad_id: mejorScore > 0 ? mejorMatch.id : null,\n      propiedad_direccion: mejorScore > 0 ? mejorMatch.direccion : null,\n      requiere_revision: mejorScore === 0,\n      score: mejorScore\n    }\n  };\n});\n\nreturn result;"
      },
