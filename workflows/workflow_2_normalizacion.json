      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, descripcion, fecha\nFROM movimientos\nWHERE periodo_inicio IS NULL\n  AND descripcion ILIKE '%/%-%/%';",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        368,
        960
      ],
      "id": "c5912481-256d-4403-ace9-0adac7bb2676",
      "name": "Leer Movimientos sin Periodo",
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "postgres (replace)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst result = [];\n\nfor (const item of items) {\n  const descripcion = item.json.descripcion || '';\n\n  // Busca el patrón DD/MM/YYYY - DD/MM/YYYY en cualquier parte del texto\n  const match = descripcion.match(/(\\d{2}\\/\\d{2}\\/\\d{4})\\s*-\\s*(\\d{2}\\/\\d{2}\\/\\d{4})/);\n\n  let periodoInicio = null;\n  let periodoFin = null;\n\n  if (match) {\n    const [, inicioStr, finStr] = match;\n    const [d1, m1, y1] = inicioStr.split('/');\n    const [d2, m2, y2] = finStr.split('/');\n    periodoInicio = `${y1}-${m1}-${d1}`;\n    periodoFin = `${y2}-${m2}-${d2}`;\n  }\n\n  result.push({\n    json: {\n      id: item.json.id,\n      periodo_inicio: periodoInicio,\n      periodo_fin: periodoFin\n    }\n  });\n}\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        576,
        960
      ],
      "id": "c1aabe05-44be-4fe4-b0b1-7218c6f4cfe7",
      "name": "Extraer Periodo"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE movimientos\nSET periodo_inicio = '{{ $json.periodo_inicio }}',\n    periodo_fin = '{{ $json.periodo_fin }}'\nWHERE id = {{ $json.id }};",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
