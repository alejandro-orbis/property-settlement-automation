      "id": "f0fa7ed1-d7cd-40ce-a666-416cde85770a",
      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst result = [];\n\nfor (const item of items) {\n  const row = item.json;\n  const importe = parseFloat(row['Importe']);\n\n  // Solo procesamos gastos (importes negativos) — los ingresos ya vienen de Rentila\n  if (isNaN(importe) || importe >= 0) continue;\n\n  const idBanco = row['ID de transacción'] || row['ID de transaccion'];\n  if (!idBanco) continue; // sin ID de transacción no podemos garantizar que no se duplique\n\nlet fecha = row['Fecha'];\nif (typeof fecha === 'number') {\n  const utc_days = Math.floor(fecha - 25569);\n  const utc_value = utc_days * 86400;\n  fecha = new Date(utc_value * 1000).toISOString().split('T')[0];\n} else if (fecha instanceof Date) {\n  fecha = fecha.toISOString().split('T')[0];\n} else if (typeof fecha === 'string' && fecha.includes('.')) {\n  const [d, m, y] = fecha.split('.');\n  fecha = `${y}-${m.padStart(2, '0')}-${d.padStart(2, '0')}`;\n}\n\n  result.push({\n    json: {\n      id_transaccion_banco: String(idBanco),\n      fecha: fecha,\n      de_a: (row['Descripción'] || row['Descripcion'] || '').substring(0, 200),\n      monto: Math.abs(importe),\n      descripcion: row['Descripción'] || row['Descripcion'] || ''\n    }\n  });\n}\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        672
      ],
      "id": "54ae28d0-bbe5-4cff-8fe8-365f3e8990b1",
      "name": "Parsear Extracto Bancario"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO movimientos (propiedad_id, fecha, de_a, monto, tipo, descripcion, estado, estado_validacion, id_transaccion_banco)\nVALUES (\n  NULL,\n  '{{ $json.fecha }}',\n  '{{ $json.de_a.replace(/'/g, \"''\") }}',\n  {{ $json.monto }},\n  'Gasto_SinClasificar',\n  '{{ $json.descripcion.replace(/'/g, \"''\") }}',\n  'Pagado',\n  'validado',\n  '{{ $json.id_transaccion_banco }}'\n)\nON CONFLICT (id_transaccion_banco) DO NOTHING;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
