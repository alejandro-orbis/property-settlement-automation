      "parameters": {
        "jsCode": "const items = $('Parsear Extracto Bancario').all();\n\nreturn [{\n  json: {\n    gastos_procesados: items.length,\n    total_importado: Math.round(items.reduce((sum, i) => sum + parseFloat(i.json.monto || 0), 0) * 100) / 100\n  }\n}];"
      },
