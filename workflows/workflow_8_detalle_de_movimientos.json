        "query": "SELECT\n  m.fecha,\n  p.direccion,\n  pr.nombre AS propietario,\n  m.tipo,\n  m.monto,\n  m.estado_validacion,\n  m.descripcion\nFROM movimientos m\nJOIN propiedades p ON p.id = m.propiedad_id\nLEFT JOIN propietarios pr ON pr.id = p.propietario_id\nORDER BY m.fecha DESC, p.direccion;",
