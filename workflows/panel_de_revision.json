    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  m.id,\n  m.fecha,\n  COALESCE(p.direccion, 'SIN IDENTIFICAR') AS propiedad,\n  m.descripcion,\n  m.monto,\n  CASE\n    WHEN m.estado_validacion = 'descuadrado' THEN 'Descuadre bancario'\n    WHEN m.estado_validacion = 'pago_parcial' THEN 'Pago parcial'\n    WHEN m.estado_validacion = 'pendiente_validar' THEN 'Sin confirmar en banco'\n    WHEN m.tipo = 'Gasto_SinClasificar_Revisar' THEN 'Gasto sin clasificar'\n    WHEN m.requiere_revision_propiedad = true THEN 'Propiedad sin identificar'\n  END AS motivo,\n  m.tipo\nFROM movimientos m\nLEFT JOIN propiedades p ON p.id = m.propiedad_id\nWHERE m.estado_validacion IN ('descuadrado', 'pago_parcial', 'pendiente_validar')\n   OR m.tipo = 'Gasto_SinClasificar_Revisar'\n   OR m.requiere_revision_propiedad = true\nORDER BY m.fecha DESC;",
        "options": {}
      },
