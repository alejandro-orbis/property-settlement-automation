{
  "name": "Workflow 7 - Rentabilidad",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  p.codigo_rentila,\n  p.direccion,\n  pr.nombre AS propietario,\n  COUNT(DISTINCT l.mes) AS meses_liquidados,\n  SUM(l.ingresos) AS ingresos_totales,\n  SUM(l.gastos) AS gastos_totales,\n  SUM(l.honorarios_gestion + l.iva) AS honorarios_totales,\n  SUM(l.neto_propietario) AS neto_acumulado,\n  COALESCE((\n    SELECT SUM(m.monto) FROM movimientos m\n    WHERE m.propiedad_id = p.id\n      AND m.tipo = 'Alquiler'\n      AND m.estado_validacion IN ('descuadrado', 'pendiente_validar', 'pago_parcial')\n  ), 0) AS impagos_detectados\nFROM propiedades p\nJOIN liquidaciones l ON l.propiedad_id = p.id\nLEFT JOIN propietarios pr ON pr.id = p.propietario_id\nGROUP BY p.id, p.codigo_rentila, p.direccion, pr.nombre\nORDER BY neto_acumulado DESC;",
        "options": {}
      },
