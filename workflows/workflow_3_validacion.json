    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, propiedad_id, de_a, monto, 'regularizacion' AS origen\nFROM regularizacion_bancaria;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        256,
        880
      ],
      "id": "a24ab54b-0f88-45d2-b365-2144d00bd206",
      "name": "Leer Regularizacion Bancaria",
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "postgres (replace)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\n\nconst movimientos = items.filter(i => i.origen === 'movimiento');\nconst regularizaciones = items.filter(i => i.origen === 'regularizacion');\n\nif (movimientos.length === 0) {\n  return [{ json: { sin_movimientos_que_validar: true } }];\n}\n\nfunction key(propId, deA) {\n  return `${propId}::${(deA || '').trim().toLowerCase()}`;\n}\n\nconst regPool = {};\nfor (const r of regularizaciones) {\n  const k = key(r.propiedad_id, r.de_a);\n  if (!regPool[k]) regPool[k] = [];\n  regPool[k].push({ id: r.id, monto: parseFloat(r.monto), used: false });\n}\n\nconst movByPerson = {};\nfor (const m of movimientos) {\n  const k = key(m.propiedad_id, m.de_a);\n  if (!movByPerson[k]) movByPerson[k] = [];\n  movByPerson[k].push(m);\n}\n\nconst results = [];\nfor (const k in movByPerson) {\n  const regs = regPool[k] || [];\n  for (const m of movByPerson[k]) {\n    const montoM = parseFloat(m.monto);\n    const exact = regs.find(r => !r.used && Math.abs(r.monto - montoM) < 0.01);\n    if (exact) {\n      exact.used = true;\n      results.push({ json: { movimiento_id: m.id, estado_validacion: 'validado', nota: `Coincidencia exacta con regularización #${exact.id} (${exact.monto}€)`, _pending: false } });\n    } else {\n      results.push({ json: { movimiento_id: m.id, estado_validacion: null, _pending: true, _monto: montoM, _key: k } });\n    }\n  }\n}\n\nfor (const k in movByPerson) {\n  const pendientes = results.filter(r => r.json._pending && r.json._key === k);\n  if (pendientes.length === 0) continue;\n  const regsSinUsar = (regPool[k] || []).filter(r => !r.used);\n  const sumaPendientes = pendientes.reduce((s, r) => s + r.json._monto, 0);\n  const sumaRegsSinUsar = regsSinUsar.reduce((s, r) => s + r.monto, 0);\n\n  if (regsSinUsar.length > 0 && Math.abs(sumaPendientes - sumaRegsSinUsar) < 0.01) {\n    for (const r of pendientes) {\n      r.json.estado_validacion = 'validado';\n      r.json.nota = `Coincide como parte de transferencia agrupada (suma total ${sumaRegsSinUsar}€: regularización(es) #${regsSinUsar.map(x => x.id).join(', ')})`;\n    }\n  } else {\n    const esPagoParcialClaro = regsSinUsar.length === 1 && pendientes.length === 1 && regsSinUsar[0].monto > 0 && regsSinUsar[0].monto < pendientes[0].json._monto;\n    for (const r of pendientes) {\n      if (esPagoParcialClaro) {\n        const pagado = regsSinUsar[0].monto;\n        const pendiente = Math.round((r.json._monto - pagado) * 100) / 100;\n        r.json.estado_validacion = 'pago_parcial';\n        r.json.nota = `Pago parcial: esperado ${r.json._monto}€, pagado ${pagado}€, pendiente ${pendiente}€`;\n        r.json.monto_cobrado = pagado;\n      } else {\n        r.json.estado_validacion = regsSinUsar.length > 0 ? 'descuadrado' : 'pendiente_validar';\n        r.json.nota = regsSinUsar.length > 0\n          ? `Existe movimiento bancario del mismo pagador pero el importe no cuadra (esperado ${r.json._monto}€, banco disponible ${sumaRegsSinUsar}€) — revisar manualmente`\n          : 'No se encontró ningún movimiento bancario correspondiente';\n      }\n    }\n  }\n}\n\nreturn results.map(r => ({\n  json: {\n    movimiento_id: r.json.movimiento_id,\n    estado_validacion: r.json.estado_validacion,\n    nota: r.json.nota,\n    monto_cobrado: r.json.monto_cobrado || null\n  }\n}));"
      },
