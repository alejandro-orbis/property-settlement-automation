    {
      "parameters": {
        "jsCode": "const items = $('Matching Inteligente').all();\nconst validados = items.filter(i => i.json.estado_validacion === 'validado').length;\nconst descuadrados = items.filter(i => i.json.estado_validacion === 'descuadrado').length;\nconst parciales = items.filter(i => i.json.estado_validacion === 'pago_parcial').length;\nconst pendientes = items.filter(i => i.json.estado_validacion === 'pendiente_validar').length;\n\nreturn [{\n  json: {\n    total_procesados: items.length,\n    validados, descuadrados, parciales, pendientes\n  }\n}];"
      },
