    {
      "parameters": {
        "jsCode": "const items = $('Calcular Comisiones Colaborador').all();\nconst total = items.reduce((sum, i) => sum + parseFloat(i.json.importe_calculado || 0), 0);\n\nreturn [{\n  json: {\n    servicios_procesados: items.length,\n    total_calculado: Math.round(total * 100) / 100\n  }\n}];"
      },
