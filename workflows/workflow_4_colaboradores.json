    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT cs.id, cs.colaborador_id, cs.propiedad_id, cs.tipo_servicio, cs.fecha, cs.horas, cs.num_visitas, cs.formalizado, p.tipo_gestion_default\nFROM colaborador_servicios cs\nLEFT JOIN propiedades p ON p.id = cs.propiedad_id\nWHERE cs.importe_calculado IS NULL;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        320,
        688
      ],
      "id": "94482172-dafd-4e5b-bb0d-ed20539b504c",
      "name": "Leer Servicios Colaborador",
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "postgres (replace)"
        }
      }
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        512,
        560
      ],
      "id": "ff4d4387-1aa7-48a6-a096-66b28fcdca1f",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "const configRows = $('Leer Config Colaboradores').all().map(i => i.json);\nconst config = {};\nfor (const row of configRows) {\n  config[row.clave] = row.valor;\n}\n\nconst servicios = $('Leer Servicios Colaborador').all().map(i => i.json);\n\nif (servicios.length === 0) {\n  return [{ json: { sin_servicios_que_calcular: true } }];\n}\n\nconst result = [];\nfor (const s of servicios) {\n  let importe = 0;\n  let detalle = '';\n  if (s.tipo_servicio === 'captacion') {\n    const visitasIncluidas = config['colaborador_captacion_visitas_incluidas'];\n    const tarifaBase = s.tipo_gestion_default === 'tradicional'\n      ? config['colaborador_captacion_tradicional_tarifa']\n      : config['colaborador_captacion_tarifa'];\n    const tarifaExtra = config['colaborador_captacion_visita_extra'];\n    const maxExtra = config['colaborador_captacion_visitas_extra_max'];\n    importe = tarifaBase;\n    detalle = `Tarifa base captación (${s.tipo_gestion_default}): ${tarifaBase}€`;\n    if (s.formalizado === false && s.num_visitas > visitasIncluidas) {\n      const visitasExtra = Math.min(s.num_visitas - visitasIncluidas, maxExtra);\n      const importeExtra = visitasExtra * tarifaExtra;\n      importe += importeExtra;\n      detalle += ` + ${visitasExtra} visitas extra × ${tarifaExtra}€ = ${importeExtra}€`;\n    }\n  }\n  else if (s.tipo_servicio === 'incidencia') {\n    const tarifaHora = config['colaborador_incidencia_tarifa_hora'];\n    const minimoHoras = config['colaborador_incidencia_minimo_horas'];\n    const horasFacturadas = Math.max(parseFloat(s.horas), minimoHoras);\n    importe = horasFacturadas * tarifaHora;\n    detalle = `${horasFacturadas}h × ${tarifaHora}€/h (mínimo ${minimoHoras}h aplicado: ${parseFloat(s.horas) < minimoHoras})`;\n  }\n  else if (s.tipo_servicio === 'salida_completa') {\n    importe = config['colaborador_salida_vivienda_completa'];\n    detalle = 'Tarifa fija salida vivienda completa';\n  }\n  else if (s.tipo_servicio === 'salida_habitacion') {\n    importe = config['colaborador_salida_habitacion'];\n    detalle = 'Tarifa fija salida habitación';\n  }\n  else if (s.tipo_servicio === 'visita_adicional') {\n    const tarifaExtra = config['colaborador_captacion_visita_extra'];\n    importe = s.num_visitas * tarifaExtra;\n    detalle = `${s.num_visitas} visitas adicionales × ${tarifaExtra}€`;\n  }\n  else if (s.tipo_servicio === 'servicio_adicional') {\n    const tarifaHora = config['colaborador_servicio_adicional_tarifa_hora'];\n    const minimoMin = config['colaborador_servicio_adicional_minimo_min'];\n    const minimoHoras = minimoMin / 60;\n    const horasFacturadas = Math.max(parseFloat(s.horas), minimoHoras);\n    importe = horasFacturadas * tarifaHora;\n    detalle = `${horasFacturadas.toFixed(2)}h × ${tarifaHora}€/h (mínimo ${minimoMin}min aplicado: ${parseFloat(s.horas) * 60 < minimoMin})`;\n  }\n  result.push({\n    json: {\n      id: s.id,\n      tipo_servicio: s.tipo_servicio,\n      importe_calculado: Math.round(importe * 100) / 100,\n      detalle: detalle\n    }\n  });\n}\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
